{
  "expo": {
    "name": "drawer",
    "slug": "drawer",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#FFFFFF",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0033"
    },
    "assetBundlePatterns": [
      "assets/card/*",
      "assets/card-thumb/*",
      "assets/tarot-cellar/*",
      "assets/icon.png",
      "assets/adaptive-icon.png",
      "assets/splash.png",
      "assets/favicon.png"
    ],
    "updates": {
      "url": "https://u.expo.dev/9bd97c79-0da9-4e10-8ea1-3504e95df837"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tarotstamp.app",
      "buildNumber": "1.0.8",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "타로 도장을 찍기 위해 사진 갤러리에 접근합니다.",
        "NSCameraUsageDescription": "타로 도장을 찍기 위해 카메라에 접근합니다.",
        "UIUserInterfaceStyle": "Light"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a0033"
      },
      "package": "com.tarotstamp.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "타로 도장을 찍기 위해 사진 갤러리에 접근합니다.",
          "cameraPermission": "타로 도장을 찍기 위해 카메라에 접근합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "networkInspector": false
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9bd97c79-0da9-4e10-8ea1-3504e95df837"
      }
    }
  }
}
