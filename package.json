{
  "name": "drawer",
  "version": "1.0.5",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clear": "expo start -c",
    "security-check": "node scripts/security-check.cjs",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions/ai-proxy/index.ts",
    "typecheck": "npm run typecheck:app",
    "test": "npm run security-check && npm run test:unit",
    "test:unit": "node --test test/services/*.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@supabase/supabase-js": "^2.48.0",
    "@tanstack/react-query": "^5.90.20",
    "dotenv": "^17.3.1",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-device": "~8.0.10",
    "expo-file-system": "~18.0.4",
    "expo-image-manipulator": "~13.0.5",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.1",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
