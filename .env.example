# Expo app public config
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AdMob app IDs are read at native build/config-plugin time.
# Use real values for production builds. If omitted, Google official test app IDs are used.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# Rewarded Ad Unit IDs used at runtime for "오늘의 운세" redraws.
# If omitted or in __DEV__, Google official rewarded test unit IDs are used.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS_UNIT_ID=

# Supabase Edge Function secrets for supabase/functions/ai-proxy
GOOGLE_API_KEY=
GOOGLE_MODEL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROXY_REQUIRE_AUTH=true
